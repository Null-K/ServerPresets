{
	"schemaVersion": 1,
	"id": "serverpresets",
	"version": "${version}",
	"name": "ServerPresets",
	"description": "Pin servers to the top of your multiplayer list. Preset servers are locked and cannot be edited, deleted, or moved by players.",
	"authors": [
		"PuddingKC"
	],
	"contact": {
		"homepage": "https://github.com/Null-K",
		"sources": "https://github.com/Null-K/ServerPresets"
	},
	"license": "ARR",
	"icon": "assets/serverpresets/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.puddingkc.serverpresets.ServerPresets"
		],
		"client": [
			"com.puddingkc.serverpresets.client.ServerPresetsClient"
		]
	},
	"mixins": [
		{
			"config": "serverpresets.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}